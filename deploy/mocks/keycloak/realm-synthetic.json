{
  "realm": "firm-synthetic",
  "enabled": true,
  "clients": [
    {
      "clientId": "pe-platform",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-secret",
      "redirectUris": [
        "http://localhost:8000/*",
        "http://localhost:5173/*"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant",
            "claim.value": "firm-synthetic",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pe-platform",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "pe-ic-members"
    },
    {
      "name": "pe-deal-team"
    }
  ],
  "users": [
    {
      "username": "ic@firm.test",
      "enabled": true,
      "emailVerified": true,
      "email": "ic@firm.test",
      "credentials": [
        {
          "type": "password",
          "value": "app-pass",
          "temporary": false
        }
      ],
      "groups": [
        "pe-ic-members"
      ],
      "firstName": "Synthetic",
      "lastName": "Partner"
    },
    {
      "username": "deal@firm.test",
      "enabled": true,
      "emailVerified": true,
      "email": "deal@firm.test",
      "credentials": [
        {
          "type": "password",
          "value": "app-pass",
          "temporary": false
        }
      ],
      "groups": [
        "pe-deal-team"
      ],
      "firstName": "Synthetic",
      "lastName": "Associate"
    }
  ]
}
